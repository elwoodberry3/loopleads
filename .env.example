# Copy to .env.local for local dev; add the same keys in Vercel → Project → Settings → Environment Variables.

# Public site URL (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://loopleads.app

# VSL video — an .mp4/.webm URL (Vercel Blob, Mux, S3) or a YouTube / Vimeo link.
# Leave empty until the video is ready: the poster shows "Video coming soon" and links to the transcript.
NEXT_PUBLIC_VSL_VIDEO_URL=
# Optional poster image (16:9). Leave empty to use the built-in poster.
NEXT_PUBLIC_VSL_POSTER_URL=

# n8n — production URL of the "Webhook" node in n8n/loopleads-demo-request.workflow.json
N8N_WEBHOOK_URL=
# Long random string. Paste the same value into the workflow's "Secret valid?" node.
# Generate one with:  openssl rand -hex 32
N8N_WEBHOOK_SECRET=
